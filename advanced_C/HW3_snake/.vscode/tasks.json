{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Snake",
            "type": "process",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-Wall",
                "-Wextra",
                "-std=c11",
                "${workspaceFolder}/HW3_snake.c",
                "-o",
                "${workspaceFolder}/HW3_snake.exe",
                "-L/C:/msys64/ucrt64/lib",
                "-lncursesw"
            ],
            "options": {
                "env": {
                    "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}
